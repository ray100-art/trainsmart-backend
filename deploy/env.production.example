# TrainSMART — production environment template
# Copy to /etc/trainsmart/backend.env on the server (never commit real secrets)

ENVIRONMENT=production
APP_NAME=TrainSMART
APP_VERSION=2.0

# PostgreSQL (required in production — SQLite is blocked by config validator)
DATABASE_URL=postgresql://trainsmart:CHANGE_ME@127.0.0.1:5432/trainsmart
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
# National tip: put PgBouncer in front of Postgres; keep app pool_size modest per worker.
# workers × (pool_size + max_overflow) must be < Postgres max_connections.

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

COOKIE_NAME=trainsmart_token
COOKIE_SECURE=True
COOKIE_SAMESITE=lax
CSRF_ENABLED=True

# Public URL of the React app (used in welcome/setup emails)
FRONTEND_URL=https://nhcsc.nascop.org

# Must match FRONTEND_URL exactly (comma-separated if multiple)
ALLOWED_ORIGINS=https://nhcsc.nascop.org

# Use database-backed rate limits when running multiple Uvicorn workers
RATE_LIMIT_STORAGE=database

# Behind nginx — required so rate limits and audit logs see real client IPs
TRUST_PROXY_HEADERS=True

# MFA temporarily off — set MFA_ENABLED=True to restore authenticator login
MFA_ENABLED=False
MFA_ENFORCE_PRIVILEGED=False
MFA_REQUIRED_ROLES=ROLE_SYSTEM_ADMIN,ROLE_NATIONAL_ADMIN,ROLE_ME_MANAGER
MFA_CHALLENGE_MINUTES=5

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
VERIFY_RATE_LIMIT_MAX=30
VERIFY_RATE_LIMIT_WINDOW_SECONDS=60

EMAIL_ENABLED=True
EMAIL_FROM=trainsmart@health.go.ke
EMAIL_PASSWORD=CHANGE_ME
EMAIL_HOST=smtp.health.go.ke
EMAIL_PORT=587
