# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (required for production; SQLite blocked when ENVIRONMENT=production)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/trainsmart
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
COOKIE_NAME=trainsmart_token
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=TrainSMART
APP_VERSION=2.0
ENVIRONMENT=development     # change to "production" in prod

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
VERIFY_RATE_LIMIT_MAX=30
VERIFY_RATE_LIMIT_WINDOW_SECONDS=60

# "memory" for single-worker dev; production always uses database regardless
RATE_LIMIT_STORAGE=memory

# Set True only behind nginx/reverse proxy that sets X-Real-IP / X-Forwarded-For
TRUST_PROXY_HEADERS=False

# Require MFA enrollment for System / National / M&E admins (set True in production)
MFA_ENFORCE_PRIVILEGED=False
MFA_REQUIRED_ROLES=ROLE_SYSTEM_ADMIN,ROLE_NATIONAL_ADMIN,ROLE_ME_MANAGER
MFA_CHALLENGE_MINUTES=5

# Comma-separated hosts for TrustedHostMiddleware (empty = disabled)
# TRUSTED_HOSTS=nhcsc.nascop.org,localhost

# Cap rows returned by M&E CSV exports
EXPORT_MAX_ROWS=10000

# Optional Moodle LMS link shown in the app (leave blank to hide)
MOODLE_URL=
