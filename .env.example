# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/transmart_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=TrainSMART
APP_VERSION=2.0
ENVIRONMENT=development     # change to "production" in prod

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=Trainsmart100%
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_ENABLED=True          # set to False to disable all email sending in dev
